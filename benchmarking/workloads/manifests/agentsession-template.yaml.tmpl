# ActorTemplate (protojson-shaped ateapipb.ActorTemplate) for the
# agent-session benchmark: one actor per simulated coding-agent session,
# driven through the 20-step script in
# internal/benchmarking/boomer/agentsession/script.go. The actor runs the
# stock glutton binary; the session's CPU/RAM/disk/network effects arrive as
# glutton RPCs through the atenet router, and the actor is suspended during
# every "LLM thinking" gap.
#
# FULL snapshots on pause and commit: a coding agent's value is its
# in-memory state (the process's context), so a resume must restore memory,
# not cold-boot. That is also what makes the resume latency this benchmark
# measures the interesting number.
#
# The session script peaks around 96Mi resident RAM plus ~110Mi of files in
# /tmp (tmpfs, so also memory). Deploy with --actor-memory 512Mi or more;
# the default 256Mi will OOM mid-session (guarded by TestSessionBudgets).
metadata:
  atespace: benchmark-workloads
  name: agentsession
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: agent
  image: ko://github.com/agent-substrate/substrate/cmd/benchmarking/glutton
  # Port 80 is the only inbound port nftables forwards from the worker pod
  # into the actor sandbox. HTTP mode lets the atenet router reach the
  # glutton routes.
  command:
  - "/ko-app/glutton"
  - "--grpc-listen-addr=:80"
  - "--metrics-listen-addr=:9090"
  - "--data-dir=/tmp/agent"
  - "--mode=http"
  env:
  - name: OTEL_EXPORTER_OTLP_ENDPOINT
    value: "${OTLP_ENDPOINT}"
  - name: OTEL_RESOURCE_ATTRIBUTES
    value: "service.name=agentsession-actor"
  # Hold ResumeActor open until port 80 actually answers.
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
  - name: memory
    quantity: ${ACTOR_MEMORY}
snapshotConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/agentsession/
sandboxConfig:
  sandboxClass: ${SANDBOX_CLASS_ENUM}
  configName: ${SANDBOX_CONFIG_NAME}
