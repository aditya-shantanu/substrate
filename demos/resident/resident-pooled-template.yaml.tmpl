# The counter workload with a resident pool: six sandboxes stay restored and running ahead of claims.
metadata:
  atespace: ate-demo-resident
  name: counter-pooled
workerSelector:
  matchLabels:
    workload: resident
containers:
- name: counter
  image: ko://go.ate.dev/substrate/demos/counter
  command: ["/ko-app/counter"]
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /home/counter
resources:
  limits:
    cpuMillicores: 500
    memoryBytes: 268435456 # 256Mi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
volumes:
- name: data
  durableDir: {}
residentPool:
  replicas: 6
