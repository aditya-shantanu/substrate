# The resident pool demo: a WorkerPool per sandbox class (the lines of a pool
# the deploy did not select are dropped by their placeholder), per guest and
# class two ActorTemplates of the counter workload (one with a resident pool,
# one without), and claimbench, which claims actors from both and serves a
# page showing each claim's latency.
#
# The ActorTemplates are not CRDs: they live in resident-*-template.yaml.tmpl
# and are created through the ate API with `kubectl ate create actor-template`.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-resident
  labels:
    # Admits claimbench through ate-system's network policy to ate-api-server.
    ate.dev/api-access: "true"

---

apiVersion: ate.dev/v1  # ${GVISOR_POOL}
kind: WorkerPool  # ${GVISOR_POOL}
metadata:  # ${GVISOR_POOL}
  name: resident-gvisor  # ${GVISOR_POOL}
  namespace: ate-demo-resident  # ${GVISOR_POOL}
  labels:  # ${GVISOR_POOL}
    workload: resident-gvisor  # ${GVISOR_POOL}
spec:  # ${GVISOR_POOL}
  replicas: ${WORKERS}  # ${GVISOR_POOL}
  workerImage: ko://go.ate.dev/substrate/cmd/ateworker-gvisor  # ${GVISOR_POOL}
  sandboxClasses:  # ${GVISOR_POOL}
  - name: gvisor  # ${GVISOR_POOL}
  template:  # ${GVISOR_POOL}
    # Capacity for every guest's residents plus the claims in flight: the  # ${GVISOR_POOL}
    # default guests book 500m each and 256Mi to 1.5Gi, twenty residents in  # ${GVISOR_POOL}
    # all.  # ${GVISOR_POOL}
    resources:  # ${GVISOR_POOL}
      limits:  # ${GVISOR_POOL}
        cpu: "12"  # ${GVISOR_POOL}
        memory: 32Gi  # ${GVISOR_POOL}
      requests:  # ${GVISOR_POOL}
        cpu: "2"  # ${GVISOR_POOL}
        memory: 32Gi  # ${GVISOR_POOL}

---

apiVersion: ate.dev/v1  # ${MICROVM_POOL}
kind: WorkerPool  # ${MICROVM_POOL}
metadata:  # ${MICROVM_POOL}
  name: resident-microvm  # ${MICROVM_POOL}
  namespace: ate-demo-resident  # ${MICROVM_POOL}
  labels:  # ${MICROVM_POOL}
    workload: resident-microvm  # ${MICROVM_POOL}
spec:  # ${MICROVM_POOL}
  replicas: ${WORKERS}  # ${MICROVM_POOL}
  workerImage: ko://go.ate.dev/substrate/cmd/ateworker-microvm  # ${MICROVM_POOL}
  sandboxClasses:  # ${MICROVM_POOL}
  - name: microvm  # ${MICROVM_POOL}
    configRef:  # ${MICROVM_POOL}
      name: microvm  # ${MICROVM_POOL}
  template:  # ${MICROVM_POOL}
    # microVM residents are whole VMs sized at the actor's memory.  # ${MICROVM_POOL}
    resources:  # ${MICROVM_POOL}
      limits:  # ${MICROVM_POOL}
        cpu: "12"  # ${MICROVM_POOL}
        memory: 48Gi  # ${MICROVM_POOL}
      requests:  # ${MICROVM_POOL}
        cpu: "2"  # ${MICROVM_POOL}
        memory: 48Gi  # ${MICROVM_POOL}

---

---

apiVersion: v1
kind: ServiceAccount
metadata:
  name: claimbench
  namespace: ate-demo-resident

---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: claimbench
  namespace: ate-demo-resident
  labels:
    app: claimbench
spec:
  replicas: 1
  selector:
    matchLabels:
      app: claimbench
  template:
    metadata:
      labels:
        app: claimbench
    spec:
      serviceAccountName: claimbench
      containers:
      - name: claimbench
        image: ko://go.ate.dev/substrate/demos/resident/claimbench
        args:
        - --atespace=ate-demo-resident
        - --guest-sizes=${GUEST_SIZES}  # dropped when the deploy measured no sizes
        ports:
        - name: http
          containerPort: 8080
        volumeMounts:
        - name: ateapi-token
          mountPath: /var/run/secrets/ateapi
          readOnly: true
        - name: podidentity
          mountPath: /run/podidentity
          readOnly: true
        - name: servicedns-ca
          mountPath: /run/servicedns-ca
          readOnly: true
      volumes:
      - name: ateapi-token
        projected:
          sources:
          - serviceAccountToken:
              audience: api.ate-system.svc
              expirationSeconds: 7200
              path: token
      - name: podidentity
        projected:
          sources:
          - podCertificate:
              credentialBundlePath: credential-bundle.pem
              keyType: ECDSAP256
              signerName: podidentity.podcert.ate.dev/identity
      - name: servicedns-ca
        projected:
          sources:
          - clusterTrustBundle:
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: trust-bundle.pem
              signerName: servicedns.podcert.ate.dev/identity

---

apiVersion: v1
kind: Service
metadata:
  name: claimbench
  namespace: ate-demo-resident
spec:
  selector:
    app: claimbench
  ports:
  - name: http
    port: 8080
    targetPort: http
