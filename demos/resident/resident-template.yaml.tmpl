# One guest of the resident pool demo, rendered twice per guest: with the
# resident pool lines kept and with them dropped. The guest image is any OCI
# image; the counter binary rides in as an image volume at /ate so the actor
# answers HTTP whatever the image's own entrypoint is, and its touch-memory
# flag makes the golden carry that much memory. The placeholders are filled by
# cmd/ate-setup/internal/demos/resident.
metadata:
  atespace: ate-demo-resident
  name: ${NAME}
workerSelector:
  matchLabels:
    workload: resident
containers:
- name: counter
  image: ${GUEST_IMAGE}
  command:
  - ${COUNTER_COMMAND}
${TOUCH_MEMORY_ARG}
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /home/counter
${COUNTER_VOLUME_MOUNT}
resources:
  limits:
    cpuMillicores: 500
    memoryBytes: ${ACTOR_MEMORY_BYTES}
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
volumes:
- name: data
  durableDir: {}
${COUNTER_VOLUME}
${RESIDENT_POOL}
